.venv
.DS_Store
__pycache__
*.egg-info/
*.code-workspace
.git_corrupt_*
ref/*
cache
artifacts

# IDE / tool dirs
.specstory/
.cursor/
.claude/
.openclaude-profile.json

# Generated figures and visualizations (regenerable from code)
figures/*.png
figures/*.mp4
figures/*.html
figures/*.json
figures/*.pkl

# Root-level generated data
*.pkl

# Generated Dymos / OpenMDAO outputs
*_out/

# Syncthing conflict files
*.sync-conflict-*

# Experiment results (regenerable from scripts)
results/
# ...except the paper's generated tables, which must be committed: they carry the
# producing commit SHA, and numbers a reader cannot trace to code are not evidence.
!doc/results/

# Specific excludes
doc/20250902_*

# Reference papers
*.pdf
rust_optimizer/target
doc/career_profile_and_advice.md

# etc/sidetrack
forethoughs

# LaTeX build artifacts (regenerable from .tex sources)
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc
*.lof
*.lot
*.nav
*.snm
*.vrb

# paper draft backups (created before each revision edit batch)
doc/*.bak-*
